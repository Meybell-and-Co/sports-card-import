{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://meybell.com/schema/sports-card.schema.json",
    "title": "Sports Collectible Schema",
    "description": "Schema for AI extraction of sports cards and related collectibles.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "entity",
        "images",
        "card",
        "subjects",
        "attributes",
        "condition",
        "ocr",
        "pipeline"
    ],
    "$defs": {
        "nullableString": {
            "type": [
                "string",
                "null"
            ]
        },
        "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "name"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "player",
                        "team",
                        "coach",
                        "manager",
                        "mascot",
                        "stadium",
                        "event",
                        "organization",
                        "other"
                    ]
                },
                "name": {
                    "type": "string"
                },
                "team": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "position": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "conditionObservation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "severity"
            ],
            "properties": {
                "type": {
                    "type": "string"
                },
                "severity": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "enum": [
                        "none",
                        "light",
                        "minor",
                        "moderate",
                        "heavy",
                        null
                    ]
                }
            }
        }
    },
    "properties": {
        "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "item_id": {
            "type": [
                "string",
                "null"
            ],
            "description": "Assigned later by inventory pipeline."
        },
        "entity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "entity_type",
                "sport"
            ],
            "properties": {
                "entity_type": {
                    "type": "string",
                    "enum": [
                        "Trading Card",
                        "Ticket",
                        "Program",
                        "Magazine",
                        "Photo",
                        "Patch",
                        "Pin",
                        "Pennant",
                        "Sticker",
                        "Poster",
                        "Autograph",
                        "Memorabilia",
                        "Other"
                    ]
                },
                "sport": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "images": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "front",
                "back"
            ],
            "properties": {
                "front": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "filename",
                        "path"
                    ],
                    "properties": {
                        "filename": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "path": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                },
                "back": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "filename",
                        "path"
                    ],
                    "properties": {
                        "filename": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "path": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                }
            }
        },
        "card": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "year": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "manufacturer": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "brand": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "set": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "subset": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "title": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "card_number": {
                    "type": [
                        "string",
                        "integer",
                        "null"
                    ]
                },
                "language": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "copyright": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "subjects": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/subject"
            }
        },
        "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "classification",
                "rookie",
                "parallel",
                "autograph",
                "memorabilia",
                "serial_numbered"
            ],
            "properties": {
                "classification": {
                    "type": "string",
                    "enum": [
                        "Base",
                        "Insert",
                        "Parallel",
                        "Checklist",
                        "Promotional",
                        "Game Card",
                        "Proof",
                        "Sample",
                        "Sticker",
                        "Team Set",
                        "Oddball",
                        "Other"
                    ]
                },
                "rookie": {
                    "type": "boolean"
                },
                "parallel": {
                    "type": "boolean"
                },
                "autograph": {
                    "type": "boolean"
                },
                "memorabilia": {
                    "type": "boolean"
                },
                "serial_numbered": {
                    "type": "boolean"
                }
            }
        },
        "condition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "overall",
                "observations"
            ],
            "properties": {
                "overall": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Optional overall assessment if supplied externally."
                },
                "observations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/conditionObservation"
                    }
                }
            }
        },
        "ocr": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "front",
                "back"
            ],
            "properties": {
                "front": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "back": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "notes": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "pipeline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "batch",
                "extractor",
                "confidence",
                "review_required"
            ],
            "properties": {
                "review_required": {
                    "type": "boolean"
                },
                "batch": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "extractor": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "confidence": {
                    "type": "string",
                    "enum": [
                        "High",
                        "Medium",
                        "Low"
                    ]
                }
            }
        }
    }
}
